@model LibraryBuddy.ViewModels.Loans.LoanCreateVm
@{
    ViewData["Title"] = "Loan Book";
}

<h2>Loan Book</h2>

<div class="mb-2"><b>Book:</b> @Model.BookTitle</div>

<form asp-action="Create" method="post" class="mt-3">
    <input asp-for="BookId" type="hidden" />
    <input asp-for="BookTitle" type="hidden" />

    <div asp-validation-summary="All" class="text-danger mb-2"></div>

    <div class="mb-3">
        <label class="form-label">Borrower name</label>
        <input asp-for="BorrowerName" class="form-control" />
        <span asp-validation-for="BorrowerName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Loan date</label>
        <input asp-for="LoanedOn" type="date" class="form-control" />
        <span asp-validation-for="LoanedOn" class="text-danger"></span>
    </div>

    <button class="btn btn-success" type="submit">Loan</button>
    <a class="btn btn-secondary" asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
