@using LibraryBuddy.Domain.Enums
@using LibraryBuddy.Domain.Entities
@model LibraryBuddy.Domain.Entities.Book

@{
    ViewData["Title"] = "Book Details";
    var activeLoan = ViewBag.ActiveLoan as Loan;
}

<h2>Book Details</h2>

<div class="card mt-3">
    <div class="card-body">
        <h4>@Model.Title</h4>
        <p class="mb-1"><b>Author:</b> @Model.Author</p>
        <p class="mb-1"><b>Genre:</b> @Model.Genre</p>
        <p class="mb-1"><b>Status:</b> @Model.Status</p>
        <p class="mt-3">@Model.Description</p>

        <div class="mt-3">
            <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
            <a class="btn btn-secondary" asp-action="Index">Back</a>

            @if (Model.Status == BookStatus.Available)
            {
                <a class="btn btn-success" asp-controller="Loans" asp-action="Create" asp-route-bookId="@Model.Id">Loan</a>
            }
            else
            {
                <a class="btn btn-warning" asp-controller="Loans" asp-action="Return" asp-route-bookId="@Model.Id">Return</a>
            }
        </div>

        @if (activeLoan is not null)
        {
            <hr />
            <p class="mb-1"><b>Loaned to:</b> @activeLoan.BorrowerName</p>
            <p class="mb-1"><b>Loaned on:</b> @activeLoan.LoanedOn</p>
        }
    </div>
</div>
